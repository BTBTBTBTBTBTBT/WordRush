<?xml version="1.0" encoding="utf-8"?>
<!-- Season preview (docs/design/brand/seasons/README.md "How to add a season"): season art is looked
     up BY NAME from season-registry.json (SeasonKit / SeasonSkins, getIdentifier), so a new season
     ships as art + registry entries with no code; keep every seasonal drawable through resource
     shrinking: cast skins + props (art_<season>_*), titles (art_title_<season>_*), walls
     (art_wall_<season>_*), Home banners (art_scene_banner_*). The normal titles / walls these
     wildcards also match are referenced from code anyway. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/art_halloween_*,@drawable/art_title_*,@drawable/art_wall_*,@drawable/art_scene_banner_*" />
