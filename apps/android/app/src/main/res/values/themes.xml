<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all UI; this base theme just provides a no-action-bar
         window with the launch lilac so there's no flash before setContent and the
         cold-start intro (FINISH_SPEC F2) picks up seamlessly from it.
         Surfaces/text are driven by the Compose theme (ported from globals.css). -->
    <style name="Theme.Wordocious" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_lilac</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- BJ10: app dialogs soft-pop (values/motion.xml). -->
        <item name="android:dialogTheme">@style/WordociousSoftPopDialog</item>
    </style>
</resources>
