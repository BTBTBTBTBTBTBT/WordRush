<?xml version="1.0" encoding="utf-8"?>
<!-- FINISH_SPEC BI13: the widget's two type sizes, both Nunito Black with tabular digits —
     the hero number (inside the ring) and the small letter-spaced caps labels. -->
<resources>
    <style name="WidgetHero">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textFontWeight">900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="WidgetCaps">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textFontWeight">900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textColor">@color/widget_label</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- The streak number set into the 3D flame: white with an orange lift. -->
    <style name="WidgetFlameNumber" parent="WidgetCaps">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:shadowColor">#B3C2410C</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">0.01</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
