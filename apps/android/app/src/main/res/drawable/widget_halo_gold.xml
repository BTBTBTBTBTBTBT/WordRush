<?xml version="1.0" encoding="utf-8"?>
<!-- Double Flawless glow (the banner's 0 0 26px rgba(245,158,11,0.8)): a widget
     can't paint outside its bounds, so the glow is an inner amber halo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="9dp" android:color="#40F59E0B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#66F59E0B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
