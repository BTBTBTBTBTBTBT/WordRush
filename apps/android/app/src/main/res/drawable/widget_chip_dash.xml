<?xml version="1.0" encoding="utf-8"?>
<!-- Unplayed-chip dashed border (iOS: strokeBorder accent 55%, 1.5pt, dash
     [4,3]). Drawn white and tinted per accent at render time via
     setColorFilter — SRC_ATOP over the white stroke pixels composites to the
     same "accent at 55% over white" iOS shows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="1.5dp"
        android:color="#FFFFFF"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="9dp" />
</shape>
