<?xml version="1.0" encoding="utf-8"?>
<!-- Widget frame (today's brand frame #a78bfa->#ec4899, outer radius 24dp). The
     one-window fill sits on top, inset 2dp, so the frame reads as a 2dp border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:startColor="#A78BFA" android:endColor="#EC4899" android:angle="315" />
    <corners android:radius="24dp" />
</shape>
