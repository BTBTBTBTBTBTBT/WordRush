<?xml version="1.0" encoding="utf-8"?>
<!-- At risk: warm wash #fef6ec->#fbf0f3, frame #f7c77e->#f397c8, amber halo.
     Layered like iOS containerBackground: full-bleed FRAME gradient (a shape
     stroke can't be a gradient, so the frame is the bottom layer showing
     through a 2.5dp inset), the theme background gradient, then a 7dp inner
     halo stroke at 10% accent. Outer radius 24dp ~ launcher corner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#F7C77E" android:endColor="#F397C8" android:angle="315" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FEF6EC" android:endColor="#FBF0F3" android:angle="315" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="7dp" android:color="#1AF59E0B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
