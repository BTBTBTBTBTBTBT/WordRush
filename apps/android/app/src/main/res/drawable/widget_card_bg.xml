<?xml version="1.0" encoding="utf-8"?>
<!-- FINISH_SPEC E2 widget card (`.wsmall` / `.wmed`): 24dp corners under the wallpaper
     bitmap; on its own (pre-API 31, or before the bitmap lands) it is the soft lilac ->
     pink home tint, never white. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:startColor="#F3EEFF" android:centerColor="#FBEFFF" android:endColor="#FFF1F7" android:angle="315" />
    <corners android:radius="24dp" />
</shape>
