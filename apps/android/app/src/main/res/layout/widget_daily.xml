<?xml version="1.0" encoding="utf-8"?>
<!-- "Daily Puzzles" medium widget — Android twin of iOS WordociousWidget.swift
     MediumView: themed header (title + streak badge + at-risk pill), 5x2 chip
     grid, footer strip (wordmark - stats - Chronometer countdown). Only
     RemoteViews-whitelisted views are used; empty LinearLayouts stand in for
     Spacer/Space (android.widget.Space is not remotable). All theme-dependent
     colors/drawables are applied at render time by DailyWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_midday"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Header: [icon] TITLE [icon] .... flame streak [pill] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_icon_lead"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_w_sparkles"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#A78BFA"
            android:maxLines="1"
            android:text="DAILY PUZZLES" />

        <ImageView
            android:id="@+id/w_icon_trail"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_w_sparkles"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/w_flame"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_flame"
            android:tint="#F59E0B"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1F2937"
            android:text="0" />

        <TextView
            android:id="@+id/w_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_risk"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="3H LEFT" />
    </LinearLayout>

