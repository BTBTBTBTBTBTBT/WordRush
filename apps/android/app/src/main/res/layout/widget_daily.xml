    <!-- Footer strip: wordmark - stats - live countdown to local midnight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_footer_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/w_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:textColor="#A78BFA"
            android:maxLines="1"
            android:text="WORDOCIOUS" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/w_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="10.5sp"
            android:textColor="#CC1F2937"
            android:maxLines="1"
            android:text="0/9" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/w_hourglass"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_w_hourglass"
            android:contentDescription="@null" />

        <Chronometer
            android:id="@+id/w_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="10.5sp"
            android:textColor="#7C3AED" />
    </LinearLayout>
