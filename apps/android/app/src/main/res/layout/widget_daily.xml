<?xml version="1.0" encoding="utf-8"?>
<!-- FINISH_SPEC E2 + AL medium widget (finishing-touches `.wmed`): the Home wallpaper, the
     cast spelling WORDOCIOUS across the top, today's eight dailies as mini game-card tiles
     (accent wash + border + 4dp accent bar + the game icon; a purple check on finished
     ones — drawn as bitmaps, RemoteViews can't layer them), today's rank (3D trophy) when
     the app has it, and a row of four labeled stat chips that ALWAYS shows: [flame] 12 DAY
     STREAK · [check] 5/18 SOLVED · [star] 3,420 POINTS · [clock] 7:42:10 NEW PUZZLES IN
     (a live Chronometer to local midnight). The cast strip is what shrinks first. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <!-- The wallpaper, a small center-cropped bitmap clipped to the corners on API 31+. -->
    <ImageView
        android:id="@+id/w_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_wall_mask"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- The cast spelling WORDOCIOUS + today's rank chip (GONE when unknown). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_cast"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxHeight="34dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <!-- Today's Daily Sweep rank as a labeled chip ([trophy] #3 / RANK); GONE when unknown. -->
            <LinearLayout
                android:id="@+id/w_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/widget_chip_points"
                android:paddingStart="5dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <LinearLayout
                    android:id="@+id/w_rank_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/w_rank_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon3d_trophy"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_rank"
                        style="@style/WidgetNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="15sp"
                        android:importantForAccessibility="no"
                        android:text="#1" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8sp"
                    android:textColor="#B45309"
                    android:text="RANK" />
            </LinearLayout>
        </LinearLayout>

        <!-- BC: the 8 Wordocious dailies across the FULL width, grown to fill. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_t0"
                android:src="@drawable/game_practice"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t1"
                android:src="@drawable/game_gauntlet"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t2"
                android:src="@drawable/game_quordle"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t3"
                android:src="@drawable/game_octordle"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t4"
                android:src="@drawable/game_sequence"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t5"
                android:src="@drawable/game_rescue"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t6"
                android:src="@drawable/game_six"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t7"
                android:src="@drawable/game_seven"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- BC: the 10 Puzzles dailies across the FULL width (no empty band above the stats). -->
        <LinearLayout
            android:id="@+id/w_puzzles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_p0"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p1"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p2"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p3"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p4"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p5"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p6"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p7"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p8"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_p9"
                android:src="@drawable/game_practice"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- AL: the four labeled stat chips (always shown). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/w_streak_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_chip_flame"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:src="@drawable/icon3d_flame"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_streak"
                        style="@style/WidgetNumber"
                        android:layout_width="0dp"
                        android:layout_height="17dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:importantForAccessibility="no"
                        android:text="0" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8sp"
                    android:textColor="#C2410C"
                    android:text="DAY STREAK" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/w_solved_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:background="@drawable/widget_chip_solved"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:src="@drawable/icon3d_badge_check"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_solved"
                        style="@style/WidgetNumber"
                        android:layout_width="0dp"
                        android:layout_height="17dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:importantForAccessibility="no"
                        android:text="0/18" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8sp"
                    android:textColor="#6D28D9"
                    android:text="SOLVED" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/w_points_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:background="@drawable/widget_chip_points"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:src="@drawable/art_badge_icon_star_sprite"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_points"
                        style="@style/WidgetNumber"
                        android:layout_width="0dp"
                        android:layout_height="17dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:importantForAccessibility="no"
                        android:text="0" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8sp"
                    android:textColor="#B45309"
                    android:text="POINTS" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/w_clock_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.35"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:background="@drawable/widget_chip_clock"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/w_clock_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null" />
                    <Chronometer
                        android:id="@+id/w_countdown"
                        style="@style/WidgetNumber"
                        android:layout_width="0dp"
                        android:layout_height="17dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8sp"
                    android:textColor="#0F766E"
                    android:importantForAccessibility="yes"
                    android:contentDescription="New puzzles in"
                    android:text="NEW PUZZLES IN" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
