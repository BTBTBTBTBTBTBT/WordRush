<?xml version="1.0" encoding="utf-8"?>
<!-- "Daily Puzzles" medium widget, home redesign (founder, 2026-10-01): the home
     banner as a widget. Frosted header strip (headline + day-streak flame), the
     Wordocious row (8 chips, 28dp) and the Puzzles row (10 chips, 25dp), each
     under its label · status · row-streak line, then the footer strip (wordmark ·
     N/18 · points · live countdown). Today's frame, chip and footer look are kept.
     Only RemoteViews-whitelisted views; empty LinearLayouts stand in for Space.
     Colors and drawables are applied at render time by DailyWidgetProvider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame_brand">

    <!-- One-window fill (the home banner's vertical tier blend + white sheen), drawn
         as a small bitmap at render time and clipped to the inner corners on API 31+.
         Older launchers hide it and fall back to a per-tier drawable on widget_root. -->
    <ImageView
        android:id="@+id/w_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:scaleType="fitXY"
        android:background="@drawable/widget_fill_mask"
        android:contentDescription="@null" />

    <!-- Inner halo: 10% violet normally, gold glow on a Double Flawless. -->
    <ImageView
        android:id="@+id/w_halo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_halo_violet"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <!-- Frosted header strip: the day's host (ART_SPEC §17) · headline (bannerHeadline) .... 3D flame day streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_strip_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/w_host"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_w"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/w_trophy"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_w_trophy"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:textSize="12.5sp"
                android:letterSpacing="0.03"
                android:textColor="#4C1D95"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="GOOD MORNING!" />

            <ImageView
                android:id="@+id/w_flame"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/icon3d_flame"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#C2410C"
                android:text="0" />
        </LinearLayout>

