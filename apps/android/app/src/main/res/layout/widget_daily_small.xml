<?xml version="1.0" encoding="utf-8"?>
<!-- FINISH_SPEC E2 + AL small widget (finishing-touches `.wsmall`, 2x2): the Home wallpaper,
     the streak chip (3D flame + soft number + DAY STREAK), four of today's dailies as mini
     game-card tiles (bitmaps; a purple check on finished ones), and the three stats it must
     ALWAYS show as labeled chips: solved (5/18 SOLVED), today's points (3,420 PTS) and a
     full-width live countdown to local midnight (NEW IN 7:42:10). Info first: the tile row
     is the only thing that shrinks (to nothing) when the widget is short. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <ImageView
        android:id="@+id/w_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_wall_mask"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="9dp">

        <!-- Streak: [flame] 12 DAY STREAK -->
        <LinearLayout
            android:id="@+id/w_streak_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_chip_flame"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon3d_flame"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/w_streak"
                style="@style/WidgetNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="17sp"
                android:importantForAccessibility="no"
                android:text="0" />
            <TextView
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#C2410C"
                android:text="DAY STREAK" />
        </LinearLayout>

        <!-- Tiles: takes whatever height is left (drops to nothing before any stat does). -->
        <LinearLayout
            android:id="@+id/w_tiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_t0"
                android:src="@drawable/game_practice"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="44dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t1"
                android:src="@drawable/game_gauntlet"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="44dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t2"
                android:src="@drawable/game_quordle"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="44dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t3"
                android:src="@drawable/game_octordle"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="44dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Two stacked chips: [check] 5/18 / SOLVED · [star] 3,420 / PTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_solved_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_chip_solved"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/icon3d_badge_check"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_solved"
                        style="@style/WidgetNumber"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="15sp"
                        android:importantForAccessibility="no"
                        android:text="0/18" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8.5sp"
                    android:textColor="#6D28D9"
                    android:text="SOLVED" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_points_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:background="@drawable/widget_chip_points"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/art_badge_icon_star_sprite"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_points"
                        style="@style/WidgetNumber"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="15sp"
                        android:importantForAccessibility="no"
                        android:text="0" />
                </LinearLayout>
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="8.5sp"
                    android:textColor="#B45309"
                    android:text="PTS" />
            </LinearLayout>
        </LinearLayout>

        <!-- Full-width countdown: [clock] NEW IN 7:42:10 (a live Chronometer to local midnight). -->
        <LinearLayout
            android:id="@+id/w_clock_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_chip_clock"
            android:paddingStart="5dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:id="@+id/w_clock_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null" />
            <TextView
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#0F766E"
                android:importantForAccessibility="yes"
                android:contentDescription="New puzzles in"
                android:text="NEW IN" />
            <Chronometer
                android:id="@+id/w_countdown"
                style="@style/WidgetNumber"
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical|end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
