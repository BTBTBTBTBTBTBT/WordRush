<?xml version="1.0" encoding="utf-8"?>
<!-- "Daily Puzzles" small widget (2x2), home redesign (founder, 2026-10-01):
     frosted header (the day's host + wordmark + 3D flame), big N/18, the banner headline in 10sp caps,
     two dot rows (the 8 Wordocious dailies, then the 10 Puzzles) and the live
     countdown. Same frame, fill and halo as the medium layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame_brand">

    <!-- One-window fill (the home banner's vertical tier blend + white sheen), drawn
         as a small bitmap at render time and clipped to the inner corners on API 31+.
         Older launchers hide it and fall back to a per-tier drawable on widget_root. -->
    <ImageView
        android:id="@+id/w_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:scaleType="fitXY"
        android:background="@drawable/widget_fill_mask"
        android:contentDescription="@null" />

    <!-- Inner halo: 10% violet normally, gold glow on a Double Flawless. -->
    <ImageView
        android:id="@+id/w_halo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_halo_violet"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_strip_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <!-- The day's host (ART_SPEC §17), at the widget's top-left corner. -->
            <ImageView
                android:id="@+id/w_host"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_w"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:textColor="#A78BFA"
                android:maxLines="1"
                android:text="WORDOCIOUS" />

            <ImageView
                android:id="@+id/w_flame"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/icon3d_flame"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#C2410C"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="2dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/w_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="#4C1D95"
            android:maxLines="1"
            android:text="0/18" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:textColor="#4C1D95"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="GOOD MORNING!" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="2dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/w_sw0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw5"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw6"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sw7"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/w_sp0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp5"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp6"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp7"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp8"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_sp9"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="2dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/w_hourglass"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_w_hourglass"
                android:contentDescription="@null" />

            <Chronometer
                android:id="@+id/w_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:textSize="10sp"
                android:textColor="#7C3AED" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
