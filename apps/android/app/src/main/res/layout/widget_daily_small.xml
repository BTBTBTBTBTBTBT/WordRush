<?xml version="1.0" encoding="utf-8"?>
<!-- FINISH_SPEC E2 + AL + AV + BC small widget (2x2): the Home wallpaper (with today's host leaning in
     top-right and three cast heads peeking up along the bottom edge, painted into the wall
     bitmap), the streak (3D flame + soft number + DAY STREAK, no box), the 8 Wordocious
     dailies as TWO rows of four big tiles filling the middle (BC: they take the empty band),
     ONE stat line ([check] 7/18 SOLVED · [star] 10,779 PTS, auto-sized, never truncated) and
     the live countdown to local midnight (NEW IN 7:42:10). The bottom 12 dp is left to the
     peeking cast so it never sits under text. Tiles are what shrink when the widget is short. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <ImageView
        android:id="@+id/w_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_wall_mask"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- Streak: [flame] 12 DAY STREAK (no box). -->
        <LinearLayout
            android:id="@+id/w_streak_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="4dp">
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/icon3d_flame"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/w_streak"
                style="@style/WidgetNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="17sp"
                android:importantForAccessibility="no"
                android:text="0" />
            <TextView
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#C2410C"
                android:text="DAY STREAK" />
        </LinearLayout>

        <!-- BC: the 8 dailies as two rows of four big tiles; they take whatever height is left. -->
        <LinearLayout
            android:id="@+id/w_tiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            android:gravity="center">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_t0"
                android:src="@drawable/game_practice"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t1"
                android:src="@drawable/game_gauntlet"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t2"
                android:src="@drawable/game_quordle"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t3"
                android:src="@drawable/game_octordle"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_t4"
                android:src="@drawable/game_sequence"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t5"
                android:src="@drawable/game_rescue"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t6"
                android:src="@drawable/game_six"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_t7"
                android:src="@drawable/game_seven"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxHeight="40dp"
                android:adjustViewBounds="true"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>
        </LinearLayout>

        <!-- ONE stat line: [check] 7/18 SOLVED · [star] 10,779 PTS (numbers auto-size, never truncate). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:id="@+id/w_solved_chip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/icon3d_badge_check"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/w_solved"
                    style="@style/WidgetNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:importantForAccessibility="no"
                    android:text="0/18" />
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textSize="7.5sp"
                    android:textColor="#6D28D9"
                    android:text="SOLVED" />
            </LinearLayout>

            <TextView
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:textColor="#8A78AD"
                android:importantForAccessibility="no"
                android:text="·" />

            <LinearLayout
                android:id="@+id/w_points_chip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/art_badge_icon_star_sprite"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/w_points"
                    style="@style/WidgetNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:importantForAccessibility="no"
                    android:text="0" />
                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textSize="7.5sp"
                    android:textColor="#B45309"
                    android:text="PTS" />
            </LinearLayout>
        </LinearLayout>

        <!-- The countdown: [clock] NEW IN 7:42:10 (a live Chronometer to local midnight). -->
        <LinearLayout
            android:id="@+id/w_clock_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_chip_clock"
            android:paddingStart="5dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <ImageView
                android:id="@+id/w_clock_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null" />
            <TextView
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#0F766E"
                android:importantForAccessibility="yes"
                android:contentDescription="New puzzles in"
                android:text="NEW IN" />
            <Chronometer
                android:id="@+id/w_countdown"
                style="@style/WidgetNumber"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical|end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
