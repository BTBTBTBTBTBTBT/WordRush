<?xml version="1.0" encoding="utf-8"?>
<!-- FINISH_SPEC BI13 small widget (iOS SmallView twin): one calm background; the hero ring
     (eight game-color segments that light up as each daily is done; gold + SWEPT when all
     are) with the count inside; the friendly W in its own corner; the streak number set into
     the 3D flame, DAY STREAK + RESETS IN 4H beside it. No boxes or outlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- 2.8 Halloween: one faint motif that rotates on each hourly flip (hidden outside the season). -->
    <ImageView
        android:id="@+id/w_motif"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="end|top"
        android:scaleType="fitEnd"
        android:alpha="0.5"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Item 28: the WORDOCIOUS lettering as an image on every size (swapped per season in code). -->
        <ImageView
            android:id="@+id/w_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:layout_marginBottom="3dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/widget_wordmark_medium_normal"
            android:contentDescription="Wordocious" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include layout="@layout/widget_ring" android:layout_width="62dp" android:layout_height="62dp" />

            <ImageView
                android:id="@+id/w_mascot"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:scaleType="fitEnd"
                android:src="@drawable/mascot_w"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include layout="@layout/widget_flame" android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">
                <TextView
                    style="@style/WidgetCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_ink"
                    android:id="@+id/w_streak_caps"
                android:text="DAY STREAK" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <!-- The gold clock sprite (night art 10-03) leads the countdown. -->
                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/art_badge_icon_clock_sprite"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/w_reset"
                        style="@style/WidgetCaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESETS IN" />
                    <!-- Item 28: the live h:m:s countdown (a Chronometer counting down to midnight). -->
                    <Chronometer
                        android:id="@+id/w_reset_t"
                        style="@style/WidgetCaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:countDown="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
