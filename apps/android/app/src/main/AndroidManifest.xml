<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- androidx.biometric arrives transitively via credentials-play-services-auth
         and contributes these two. NOTHING in the app uses biometrics, and
         USE_FINGERPRINT has been deprecated since API 28 — a deprecated
         fingerprint permission on a word game is exactly the kind of thing that
         draws a review question and shows up on the Play listing's permission
         list for no reason. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wordocious">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wordocious">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App links: ONLY /vs/join/* opens in the app (handled by
                 DeepLinkRouter). The old host-wide filter claimed every
                 wordocious.com link and then discarded the path — referral
                 /join/*, share /s/*, and content pages belong in the browser.
                 autoVerify needs /.well-known/assetlinks.json to carry the
                 Play App Signing SHA-256 (task #50). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wordocious.com" android:pathPrefix="/vs/join/" />
                <data android:scheme="https" android:host="wordocious.com" android:pathPrefix="/auth/reset" />
                <data android:scheme="https" android:host="wordocious.com" android:pathPrefix="/auth/confirm" />
            </intent-filter>
            <!-- Return leg of the browser Google sign-in fallback. Supabase
                 sends the browser here after the OAuth round-trip; the session
                 is parsed by handleDeeplinks() in MainActivity. Custom scheme,
                 so no autoVerify / assetlinks involvement. Must match the
                 scheme+host configured on install(Auth) in SupabaseConfig. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wordocious" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- Sentry crash reporting (manifest auto-init, no gradle plugin).
             The DSN is release-only — see src/release/AndroidManifest.xml —
             so debug builds have no DSN and Sentry stays inert. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="true" />
        <meta-data
            android:name="io.sentry.traces.sample-rate"
            android:value="0.0" />

        <!-- §252: the AdMob APPLICATION_ID meta-data is gone with AdMob itself.
             AppLovin takes its SDK key at runtime (AdsManager.kt), not here. -->

        <!-- Share-image pipeline: exposes the rendered PNG in cacheDir/share to
             the system share sheet (read-only, per-grant). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- "Daily Puzzles" home-screen widget (the iOS WordociousDaily twin).
             Data arrives via WidgetBridge (SharedPreferences snapshot) on
             every completion change; timed look-flips via inexact alarms. -->
        <receiver
            android:name=".widget.DailyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_info" />
        </receiver>

        <!-- Re-anchor the 18:00-local daily reminder when the timezone or
             clock changes (the pending one-shot's delay was computed in the
             old zone). TIMEZONE_CHANGED/TIME_SET need no permission. -->
        <receiver
            android:name=".data.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <!-- FCM token + message callbacks. Not exported: only the Firebase
             SDK binds it, via the framework's own MESSAGING_EVENT action. -->
        <service
            android:name=".data.WordociousMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
